# Reachable URL for the existing Stratos-PRJMS-Inventory Express server.
# Use your computer's LAN IP when testing on a physical phone.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:2588

# The database Affiliate.id whose Affiliate.code is STRATOS.
# This pins Superadmin requests and prevents cross-company access.
EXPO_PUBLIC_STRATOS_AFFILIATE_ID=1

EXPO_PUBLIC_BIOMETRIC_SECURITY_LEVEL=strong

# Optional OAuth client for an iOS native build. Android uses the server's
# public GOOGLE_CLIENT_ID as webClientId so the backend accepts the ID token.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# GOOGLE_CLIENT_ID, NEXT_PUBLIC_GOOGLE_CLIENT_ID, and GOOGLE_CLIENT_SECRET
# belong in the Stratos server environment, never in this mobile environment.
